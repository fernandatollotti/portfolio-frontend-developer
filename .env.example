# Public site URL, used for metadata, canonical links, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=https://seudominio.com

# Optional — pick ONE of these two, not both (see src/components/Analytics.tsx):

# Google Tag Manager container ID (e.g. GTM-XXXXXXX), recommended if you'll manage
# GA4/Meta Pixel/conversion tags without touching code again. Get one at
# https://tagmanager.google.com.
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX), loaded directly — simpler
# if GTM is more than you need. Get one at https://analytics.google.com.
NEXT_PUBLIC_GA_ID=

# Optional — Google Search Console HTML-tag verification code (just the content
# value, not the whole <meta> tag). Get one at https://search.google.com/search-console
# by choosing the "HTML tag" verification method.
GOOGLE_SITE_VERIFICATION=

# NEXT_PUBLIC_BASE_PATH is NOT needed here — it's only set inside
# .github/workflows/deploy.yml for the GitHub Pages build. Leaving it unset locally
# keeps `npm run dev` / `npm run build` in normal server mode. See the README's
# "Deploy (GitHub Pages)" section.
