# Public site URL, used for metadata, canonical links, sitemap and robots.txt.
# Defaults to https://fernandatollotti.com.br when unset.
NEXT_PUBLIC_SITE_URL=https://fernandatollotti.com.br

# Optional — Google Tag Manager container ID (e.g. GTM-XXXXXXX). When set, GTM is
# loaded instead of GA4 (see src/components/Analytics.tsx).
NEXT_PUBLIC_GTM_ID=

# Optional — overrides the GA4 measurement ID (default G-HME1HCRWZX, in
# src/lib/site.ts). Analytics only loads in production builds, after consent.
NEXT_PUBLIC_GA_ID=

# Optional — Google Search Console HTML-tag verification code (just the content
# value, not the whole <meta> tag). Get one at https://search.google.com/search-console
# by choosing the "HTML tag" verification method.
GOOGLE_SITE_VERIFICATION=
